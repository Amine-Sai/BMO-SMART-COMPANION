{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BMO Assistant MQTT Communication Protocols",
  "description": "Specification for all MQTT topics, message schemas, control commands, vision events, and context feeds between BMO Computer Vision and external TTS / LLM Agents.",
  "version": "1.0.0",
  "mqtt_server": {
    "default_host": "localhost",
    "default_port": 1883,
    "transport": "tcp",
    "client_id": "bmo_vision_pipeline",
    "keepalive_seconds": 30,
    "qos": 0,
    "socket_options": {
      "TCP_NODELAY": 1,
      "description": "Nagle algorithm disabled for sub-millisecond local network dispatch"
    },
    "serialization": {
      "primary": "orjson (UTF-8 bytes, non-str keys allowed)",
      "fallback": "standard json"
    },
    "environment_variables": {
      "BMO_MQTT_HOST": {
        "description": "IP address or hostname of the MQTT broker",
        "default": "localhost"
      },
      "BMO_MQTT_PORT": {
        "description": "Port of the MQTT broker",
        "default": 1883
      },
      "BMO_MQTT_TOPIC_CMD": {
        "description": "MQTT topic for incoming commands to BMO vision",
        "default": "bmo/vision/command"
      },
      "BMO_MQTT_TOPIC_EVENT": {
        "description": "MQTT topic for outgoing real-time vision events",
        "default": "bmo/vision/events"
      },
      "BMO_MQTT_TOPIC_CTX": {
        "description": "MQTT topic for periodic and on-demand short-term memory context",
        "default": "bmo/vision/context"
      },
      "BMO_MQTT_TOPIC_RESP": {
        "description": "MQTT topic for command responses and status acknowledgments",
        "default": "bmo/vision/response"
      }
    }
  },
  "topics": {
    "bmo/vision/command": {
      "direction": "incoming",
      "description": "Asynchronous command queue for controlling vision modes, face/object enrollment, and memory queries.",
      "qos": 0
    },
    "bmo/vision/events": {
      "direction": "outgoing",
      "description": "Edge-triggered real-time events published as they occur (person enter/leave, face ID, signs).",
      "qos": 0
    },
    "bmo/vision/context": {
      "direction": "outgoing",
      "description": "Short-term scene memory and natural language scene summaries published periodically (every 5s) and on demand.",
      "qos": 0
    },
    "bmo/vision/response": {
      "direction": "outgoing",
      "description": "Command acknowledgments, progress updates, success payloads, and error reports.",
      "qos": 0
    }
  },
  "commands": {
    "enroll_person": {
      "aliases": ["save_person", "remember_person"],
      "description": "Initiate hands-free multi-shot face enrollment for a person with viewpoint diversity checks.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "enum": ["enroll_person", "save_person", "remember_person"] },
          "name": { "type": "string", "description": "Display name to associate with the person", "default": "User" },
          "shots": { "type": "integer", "description": "Number of diverse face angles required", "default": 8 },
          "request_id": { "type": "string", "description": "Optional correlation identifier" }
        },
        "required": ["command", "name"]
      },
      "example_request": {
        "command": "enroll_person",
        "name": "Alice",
        "shots": 8,
        "request_id": "req-face-001"
      },
      "responses": [
        {
          "status": "started",
          "data": { "name": "Alice" }
        },
        {
          "status": "completed",
          "data": { "name": "Alice" }
        },
        {
          "status": "already_registered",
          "data": { "name": "Alice", "registered_as": "Alice", "error": "Person is already registered as 'Alice'" }
        },
        {
          "status": "failed",
          "data": { "error": "Enrollment timed out" }
        }
      ]
    },
    "delete_person": {
      "aliases": ["forget_person"],
      "description": "Permanently remove a person from the biometric identity registry and delete visual embeddings.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "enum": ["delete_person", "forget_person"] },
          "name": { "type": "string", "description": "Name or ID of person to delete" },
          "request_id": { "type": "string" }
        },
        "required": ["command", "name"]
      },
      "example_request": {
        "command": "delete_person",
        "name": "Alice",
        "request_id": "req-face-002"
      },
      "responses": [
        { "status": "success", "data": { "name": "Alice" } },
        { "status": "not_found", "data": { "name": "Alice", "error": "Person 'Alice' not found" } }
      ]
    },
    "rename_person": {
      "description": "Rename a registered person and update gallery metadata without losing visual embeddings.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "const": "rename_person" },
          "old_name": { "type": "string" },
          "new_name": { "type": "string" },
          "request_id": { "type": "string" }
        },
        "required": ["command", "old_name", "new_name"]
      },
      "example_request": {
        "command": "rename_person",
        "old_name": "Alice",
        "new_name": "Alicia",
        "request_id": "req-face-003"
      },
      "responses": [
        { "status": "success", "data": { "old_name": "Alice", "new_name": "Alicia" } },
        { "status": "error", "data": { "error": "Failed to rename 'Alice'" } }
      ]
    },
    "list_persons": {
      "aliases": ["list_identities", "get_roster"],
      "description": "List all registered identities in the biometric gallery with encounter counts and timestamps.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "enum": ["list_persons", "list_identities", "get_roster"] },
          "request_id": { "type": "string" }
        },
        "required": ["command"]
      },
      "example_request": {
        "command": "list_persons",
        "request_id": "req-face-004"
      },
      "responses": [
        {
          "status": "success",
          "data": {
            "persons": [
              {
                "id": "alice",
                "name": "Alice",
                "encounters": 14,
                "created_at": "2026-11-06T20:30:00Z",
                "last_seen": "2026-11-07T12:00:00Z"
              }
            ],
            "count": 1
          }
        }
      ]
    },
    "recheck_face": {
      "aliases": ["reverify_face"],
      "description": "Wake the facial recognition worker in lazy mode to reverify a specific track ID or all visible persons.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "enum": ["recheck_face", "reverify_face"] },
          "track_id": { "type": ["integer", "null"], "description": "Target track ID or null for all visible tracks" },
          "request_id": { "type": "string" }
        },
        "required": ["command"]
      },
      "example_request": {
        "command": "recheck_face",
        "track_id": 1,
        "request_id": "req-face-005"
      },
      "responses": [
        { "status": "success", "data": { "flagged_track": 1 } }
      ]
    },
    "register_object": {
      "aliases": ["enroll_object", "save_object"],
      "description": "Learn a new object. If shots > 0, collects multi-angle visual crops and stores a 512-D exemplar. If shots = 0, instantly updates YOLO-World zero-shot text vocabulary.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "enum": ["register_object", "enroll_object", "save_object"] },
          "name": { "type": "string", "description": "Display label for the object" },
          "shots": { "type": "integer", "description": "Shots to collect (0 for text-only, >0 for visual exemplar)", "default": 6 },
          "synonyms": { "type": "array", "items": { "type": "string" }, "description": "Alternative prompts" },
          "request_id": { "type": "string" }
        },
        "required": ["command", "name"]
      },
      "example_request": {
        "command": "register_object",
        "name": "lighter",
        "shots": 6,
        "synonyms": ["cigarette lighter", "bic lighter"],
        "request_id": "req-obj-001"
      },
      "responses": [
        { "status": "started", "data": { "name": "lighter", "shots": 6 } },
        { "status": "completed", "data": { "name": "lighter", "shots": 6 } },
        { "status": "success", "data": { "name": "lighter", "mode": "text" } },
        { "status": "failed", "data": { "error": "Object enrollment timed out" } }
      ]
    },
    "delete_object": {
      "aliases": ["forget_object"],
      "description": "Delete a registered object from the gallery and reload active detector classes.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "enum": ["delete_object", "forget_object"] },
          "name": { "type": "string" },
          "request_id": { "type": "string" }
        },
        "required": ["command", "name"]
      },
      "example_request": {
        "command": "delete_object",
        "name": "lighter",
        "request_id": "req-obj-002"
      },
      "responses": [
        { "status": "success", "data": { "name": "lighter" } },
        { "status": "not_found", "data": { "name": "lighter", "error": "Object 'lighter' not found" } }
      ]
    },
    "rename_object": {
      "description": "Rename a registered object and update associated exemplar vectors and vocabulary.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "const": "rename_object" },
          "old_name": { "type": "string" },
          "new_name": { "type": "string" },
          "request_id": { "type": "string" }
        },
        "required": ["command", "old_name", "new_name"]
      },
      "example_request": {
        "command": "rename_object",
        "old_name": "lighter",
        "new_name": "pocket lighter",
        "request_id": "req-obj-003"
      },
      "responses": [
        { "status": "success", "data": { "old_name": "lighter", "new_name": "pocket lighter" } },
        { "status": "error", "data": { "error": "Object 'lighter' not found" } }
      ]
    },
    "list_objects": {
      "aliases": ["get_objects"],
      "description": "Return all registered custom objects and visual exemplar metadata.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "enum": ["list_objects", "get_objects"] },
          "request_id": { "type": "string" }
        },
        "required": ["command"]
      },
      "example_request": {
        "command": "list_objects",
        "request_id": "req-obj-004"
      },
      "responses": [
        {
          "status": "success",
          "data": {
            "objects": [
              {
                "id": "lighter",
                "name": "lighter",
                "synonyms": ["cigarette lighter"],
                "has_exemplar": true,
                "encounters": 3
              }
            ],
            "count": 1
          }
        }
      ]
    },
    "set_object_classes": {
      "description": "Hot-reload the active YOLO-World detection vocabulary with a custom list of class names.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "const": "set_object_classes" },
          "classes": { "type": "array", "items": { "type": "string" } },
          "request_id": { "type": "string" }
        },
        "required": ["command", "classes"]
      },
      "example_request": {
        "command": "set_object_classes",
        "classes": ["person", "laptop", "mug", "lighter", "cell phone"],
        "request_id": "req-obj-005"
      },
      "responses": [
        { "status": "success", "data": { "classes": ["person", "laptop", "mug", "lighter", "cell phone"] } },
        { "status": "error", "data": { "error": "Missing or invalid classes list" } }
      ]
    },
    "get_context": {
      "description": "Fetch immediate short-term visual memory context and natural language summary for LLM prompt generation.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "const": "get_context" },
          "request_id": { "type": "string" }
        },
        "required": ["command"]
      },
      "example_request": {
        "command": "get_context",
        "request_id": "req-ctx-001"
      },
      "responses": [
        {
          "status": "success",
          "data": {
            "context": {
              "timestamp": 1794052310.5,
              "summary": "Seeing User (center, close). Visible objects: 1 laptop, 1 lighter.",
              "current_persons": [
                {
                  "track_id": 1,
                  "identity": "User",
                  "face_conf": 0.88,
                  "position": "center",
                  "proximity": "close",
                  "bbox": [150, 80, 480, 470]
                }
              ],
              "recent_persons": [],
              "current_objects": [
                { "label": "laptop", "count": 1, "boxes": [[100, 300, 350, 470]] },
                { "label": "lighter", "count": 1, "boxes": [[380, 240, 420, 310]] }
              ],
              "recent_signs": [],
              "recent_events": [
                { "event": "person_detected", "ago_sec": 12.4, "data": { "count": 1, "diff": 1 } },
                { "event": "face_identified", "ago_sec": 12.1, "data": { "name": "User" } }
              ],
              "known_persons": ["User"],
              "registered_objects": ["lighter"]
            }
          }
        }
      ]
    },
    "set_mode": {
      "description": "Switch pipeline execution state between lazy, active (all models awake), or idle (face/sign sleep).",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "const": "set_mode" },
          "mode": { "type": "string", "enum": ["lazy", "active", "all", "idle"] },
          "request_id": { "type": "string" }
        },
        "required": ["command", "mode"]
      },
      "example_request": {
        "command": "set_mode",
        "mode": "lazy",
        "request_id": "req-mode-001"
      },
      "responses": [
        { "status": "applied", "data": { "mode": "lazy" } }
      ]
    },
    "status": {
      "description": "Retrieve pipeline operational health, current frame rate, lazy mode state, and toggle statuses.",
      "topic": "bmo/vision/command",
      "request_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "const": "status" },
          "request_id": { "type": "string" }
        },
        "required": ["command"]
      },
      "example_request": {
        "command": "status",
        "request_id": "req-stat-001"
      },
      "responses": [
        {
          "status": "ok",
          "data": {
            "fps": 43.5,
            "lazy_mode": true,
            "toggles": {
              "1:OBJ": true,
              "2:FACE": true,
              "3:SIGN": true,
              "L:LAZY": true,
              "T:TRK": true
            },
            "persons_in_view": 1
          }
        }
      ]
    }
  },
  "events": {
    "person_detected": {
      "topic": "bmo/vision/events",
      "description": "Dispatched immediately when one or more persons enter the camera field of view.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "const": "event" },
          "event": { "type": "string", "const": "person_detected" },
          "timestamp": { "type": "number" },
          "data": {
            "type": "object",
            "properties": {
              "count": { "type": "integer", "description": "Current number of persons visible" },
              "diff": { "type": "integer", "description": "Net increase in persons detected" }
            },
            "required": ["count", "diff"]
          }
        },
        "required": ["type", "event", "timestamp", "data"]
      },
      "example": {
        "type": "event",
        "event": "person_detected",
        "timestamp": 1794052301.831,
        "data": { "count": 1, "diff": 1 }
      }
    },
    "person_left": {
      "topic": "bmo/vision/events",
      "description": "Dispatched when one or more persons exit the camera field of view.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "const": "event" },
          "event": { "type": "string", "const": "person_left" },
          "timestamp": { "type": "number" },
          "data": {
            "type": "object",
            "properties": {
              "count": { "type": "integer", "description": "Current number of persons remaining visible" },
              "diff": { "type": "integer", "description": "Net decrease in persons detected" }
            },
            "required": ["count", "diff"]
          }
        },
        "required": ["type", "event", "timestamp", "data"]
      },
      "example": {
        "type": "event",
        "event": "person_left",
        "timestamp": 1794052302.052,
        "data": { "count": 0, "diff": 1 }
      }
    },
    "face_identified": {
      "topic": "bmo/vision/events",
      "description": "Dispatched on transition when a known identity in the biometric gallery is positively recognized.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "const": "event" },
          "event": { "type": "string", "const": "face_identified" },
          "timestamp": { "type": "number" },
          "data": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Recognized person name from gallery" }
            },
            "required": ["name"]
          }
        },
        "required": ["type", "event", "timestamp", "data"]
      },
      "example": {
        "type": "event",
        "event": "face_identified",
        "timestamp": 1794052301.849,
        "data": { "name": "User" }
      }
    },
    "sign_recognized": {
      "topic": "bmo/vision/events",
      "description": "Dispatched when a sign language gesture exceeds probability threshold (SIGN_CONF >= 0.90).",
      "payload_schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "const": "event" },
          "event": { "type": "string", "const": "sign_recognized" },
          "timestamp": { "type": "number" },
          "data": {
            "type": "object",
            "properties": {
              "sign": { "type": "string", "description": "Recognized gesture label (e.g. hello, thanks, yes)" },
              "conf": { "type": "number", "description": "Inference confidence score between 0.0 and 1.0" }
            },
            "required": ["sign", "conf"]
          }
        },
        "required": ["type", "event", "timestamp", "data"]
      },
      "example": {
        "type": "event",
        "event": "sign_recognized",
        "timestamp": 1794052304.120,
        "data": { "sign": "hello", "conf": 0.94 }
      }
    },
    "person_enrolled": {
      "topic": "bmo/vision/events",
      "description": "Dispatched when an interactive or hands-free face auto-enrollment completes successfully.",
      "payload_schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "const": "event" },
          "event": { "type": "string", "const": "person_enrolled" },
          "timestamp": { "type": "number" },
          "data": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Enrolled person identity name" }
            },
            "required": ["name"]
          }
        },
        "required": ["type", "event", "timestamp", "data"]
      },
      "example": {
        "type": "event",
        "event": "person_enrolled",
        "timestamp": 1794052306.750,
        "data": { "name": "Alice" }
      }
    }
  },
  "context_feed": {
    "topic": "bmo/vision/context",
    "broadcast_interval_seconds": 5.0,
    "description": "High-level summary of active visual field streamed periodically when someone is in view, or returned in response to 'get_context'. Formatted directly for LLM system prompt context injection.",
    "payload_schema": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "context" },
        "request_id": { "type": ["string", "null"] },
        "timestamp": { "type": "number" },
        "context": {
          "type": "object",
          "properties": {
            "timestamp": { "type": "number" },
            "summary": { "type": "string", "description": "Single-sentence natural language overview for direct LLM ingestion" },
            "current_persons": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "track_id": { "type": "integer" },
                  "identity": { "type": "string" },
                  "face_conf": { "type": "number" },
                  "position": { "type": "string", "enum": ["left", "center", "right"] },
                  "proximity": { "type": "string", "enum": ["close", "medium", "far"] },
                  "bbox": { "type": "array", "items": { "type": "integer" } }
                }
              }
            },
            "recent_persons": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "identity": { "type": "string" },
                  "ago_sec": { "type": "number" }
                }
              }
            },
            "current_objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "count": { "type": "integer" },
                  "boxes": { "type": "array" }
                }
              }
            },
            "recent_signs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sign": { "type": "string" },
                  "conf": { "type": "number" },
                  "signer": { "type": ["string", "null"] },
                  "ago_sec": { "type": "number" }
                }
              }
            },
            "recent_events": { "type": "array" },
            "known_persons": { "type": "array", "items": { "type": "string" } },
            "registered_objects": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["timestamp", "summary", "current_persons", "current_objects", "known_persons", "registered_objects"]
        }
      },
      "required": ["type", "timestamp", "context"]
    }
  }
}