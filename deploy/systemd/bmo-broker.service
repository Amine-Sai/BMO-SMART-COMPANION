[Unit]
Description=BMO MQTT Broker
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/judas/bmo-assistant
# Alternate production command when system mosquitto is installed:
# ExecStart=/usr/bin/mosquitto -c /home/judas/bmo-assistant/infra/mosquitto.conf
ExecStart=/home/judas/bmo-assistant/.venv/bin/python -m tools.simple_broker --host 127.0.0.1 --port 1883
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
