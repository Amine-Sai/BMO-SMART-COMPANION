[Unit]
Description=BMO Brain Service
After=network.target bmo-broker.service

[Service]
Type=simple
WorkingDirectory=%h/bmo-assistant
ExecStart=%h/bmo-assistant/.venv/bin/python -m brain.main
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
SupplementaryGroups=audio video

[Install]
WantedBy=multi-user.target
