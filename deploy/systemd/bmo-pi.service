[Unit]
Description=BMO Pi Edge Client Service
After=network.target bmo-broker.service

[Service]
Type=simple
WorkingDirectory=%h/bmo-assistant
EnvironmentFile=-%h/.config/bmo/pi.env
ExecStart=%h/bmo-assistant/.venv/bin/python -m edge.pi_client
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
SupplementaryGroups=audio video

[Install]
WantedBy=multi-user.target
