[Unit]
Description=BMO Computer Vision Service
After=network.target bmo-broker.service

[Service]
Type=simple
WorkingDirectory=/home/judas/bmo-assistant
ExecStart=/home/judas/bmo-assistant/.venv/bin/python -m assistant_cv.main --headless
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
